# Modelo rastreável de variáveis. Copie para .env e preencha localmente.
# .env NÃO é versionado; .env.example é.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime: URL pooled do Neon com role de menor privilégio (ex.: mgh_app),
# SEM BYPASSRLS. Nunca use a role owner/direct aqui: ela ignora RLS FORCE.
DATABASE_URL=
# Migrações/seed: URL direta do Neon com role owner. Nunca use no runtime.
DIRECT_URL=

# Autenticação real (Auth.js + auth_credentials). Nunca versionar a senha.
# As duas variáveis abaixo são usadas somente por prisma/seed-auth.mjs;
# não são necessárias no runtime da Vercel.
# O hash tem o formato scrypt$salt_hex$derived_hex, gerado por lib/auth/password.ts.
AUTH_SEED_PASSWORD_HASH=
# Opcionais: se ausentes, o seed usa IDs sintéticos fixos em prisma/seed-auth.mjs.
AUTH_SEED_TENANT_ID=
# Na Vercel, AUTH_URL deve ser a URL pública de produção. AUTH_TRUST_HOST
# pode ficar true; fora da Vercel, produção exige valor explícito.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

AUTH_SECRET=
JWT_TENANT_CLAIM=tenantId
JWT_ROLE_CLAIM=role
TENANT_SESSION_SETTING=app.current_tenant_id

NEON_BRANCH=local
NEON_PREVIEW_PREFIX=preview/pr-
NEON_QA_PREFIX=qa/
NEON_RECOVERY_PREFIX=recovery/

MGH_PHASE=A
MGH_BANK_STATUS=DRAFT
MGH_REQUIRE_CANONICAL_ITEMS=true
MGH_ALLOW_REAL_PARTICIPANTS=false
MGH_AI_ENABLED=false
MGH_ALLOW_INDIVIDUAL_RESPONSE_ACCESS=false
MGH_DR_RANDOMIZATION=false
MGH_SELF_IN_SCORE=false

RPO=
RTO=

SENTRY_DSN=
